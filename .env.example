# Public brand: SongSnuggle (`songsnuggle.com`)
# Code / repo name stays Hearloom.
NEXT_PUBLIC_BRAND_NAME=SongSnuggle
NEXT_PUBLIC_BRAND_TAGLINE=A song they can keep.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@songsnuggle.com
NEXT_PUBLIC_SONG_PRICE=39
NEXT_PUBLIC_LYRICS_PRICE=19

# Public URL (needed for Whop return + webhook).
# Local:
APP_URL=http://localhost:3000
# Production (songsnuggle.com on Cloudflare):
# APP_URL=https://songsnuggle.com

# Resend — delivery email after unlock (Whop webhook / demo-pay / FREESNUGGLE).
# Required for email. Without it, unlock still works; email is skipped with a log line.
# Production (Cloudflare Worker songsnuggle):
#   npx wrangler secret put RESEND_API_KEY
# Optional From (default below). Domain songsnuggle.com must be verified in Resend:
#   https://resend.com/domains → add DNS → then:
#   npx wrangler secret put RESEND_FROM
#   value example: SongSnuggle <hello@songsnuggle.com>
# RESEND_API_KEY=
# RESEND_FROM=SongSnuggle <hello@songsnuggle.com>


# Lyrics. Anthropic Claude Opus is the recommended writer.
# LYRIC_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
#
# Cheaper/faster option: claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5
#
# LYRIC_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
#
# LYRIC_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Whop — live company (skip sandbox.whop.com). Then run: npm run sync:whop
WHOP_COMPANY_API_KEY=
WHOP_COMPANY_ID=
# WHOP_SANDBOX=true
WHOP_WEBHOOK_SECRET=
WHOP_PRODUCT_ID=
WHOP_PLAN_ID_SONG=
WHOP_PLAN_ID_BUNDLE=

# Demo unlock without Whop keys (local). Production keeps this off.
# DEMO_CHECKOUT=false
# Promo FREESNUGGLE unlocks via POST /api/demo-pay even when demo is off (no Joseph cash).

# Music. Production default when ELEVENLABS_API_KEY is set: ElevenLabs Music
# (composition plans → full song vocals + instrumental). Beautiful gift path.
# wrangler secret put ELEVENLABS_API_KEY
# ELEVENLABS_API_KEY=
# MUSIC_PROVIDER=elevenlabs
#
# Fallback / forced xAI Grok TTS vocals (+ light synth bed) when MUSIC_PROVIDER=xai
# or only XAI_API_KEY is set (no EL key).
# wrangler secret put XAI_API_KEY
# XAI_API_KEY=
# MUSIC_PROVIDER=xai
#
# Local formant synth only (never production default):
# MUSIC_PROVIDER=synth
