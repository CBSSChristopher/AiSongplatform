# Hearloom
NEXT_PUBLIC_BRAND_NAME=Hearloom
NEXT_PUBLIC_BRAND_TAGLINE=A song they can keep.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@hearloom.app
NEXT_PUBLIC_SONG_PRICE=39
NEXT_PUBLIC_LYRICS_PRICE=19

# Public URL of this app (needed for Whop return + webhook)
APP_URL=http://localhost:3000

# Demo checkout is on automatically until Whop keys are set.
# DEMO_CHECKOUT=true

# Lyrics. Pick one provider. If none are set, Hearloom uses the built-in template.
# LYRIC_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
#
# LYRIC_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
#
# LYRIC_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Whop — paste these, then run: npm run sync:whop
WHOP_COMPANY_API_KEY=
WHOP_COMPANY_ID=
WHOP_SANDBOX=true
WHOP_WEBHOOK_SECRET=
WHOP_PRODUCT_ID=
WHOP_PLAN_ID_SONG=
WHOP_PLAN_ID_BUNDLE=
