# Hearloom
NEXT_PUBLIC_BRAND_NAME=Hearloom
NEXT_PUBLIC_BRAND_TAGLINE=A song they can keep.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@hearloom.app
NEXT_PUBLIC_SONG_PRICE=39
NEXT_PUBLIC_LYRICS_PRICE=19

# Public URL of this app (needed for Whop return + webhook)
APP_URL=http://localhost:3000

# Optional. Sends the private song link after payment.
# RESEND_API_KEY=
# RESEND_FROM=Hearloom <hello@hearloom.app>


# Lyrics. Anthropic Claude Opus is the recommended writer.
# LYRIC_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
#
# Cheaper/faster option: claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5
#
# LYRIC_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
#
# LYRIC_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Whop — live company (skip sandbox.whop.com). Then run: npm run sync:whop
WHOP_COMPANY_API_KEY=
WHOP_COMPANY_ID=
# WHOP_SANDBOX=true
WHOP_WEBHOOK_SECRET=
WHOP_PRODUCT_ID=
WHOP_PLAN_ID_SONG=
WHOP_PLAN_ID_BUNDLE=
